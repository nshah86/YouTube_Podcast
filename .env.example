# VideoTranscript Pro — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- Flask ---
SECRET_KEY=change-me-to-a-long-random-string
APP_ENV=development            # development | production | testing
FLASK_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000   # public URL, used for Stripe redirects

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key   # server-side only (webhooks, billing)

# --- OpenAI (AI summaries + podcast scripts) ---
OPENAI_API_KEY=sk-...

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create these Prices in the Stripe Dashboard (recurring, monthly, USD),
# then paste the Price IDs:
STRIPE_PRICE_PLUS_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...

# --- Optional ---
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
HF_TOKEN=
USER_AGENT=VideoTranscriptPro/1.0
LOG_LEVEL=INFO
# Dev-only API token overrides (do NOT use in production):
# API_TOKEN_FREE=
# API_TOKEN_PLUS=
# API_TOKEN_PRO=

# --- Transcript fallback chain (optional) ---
# Official YouTube Data API v3 key. Only helps for videos you own
# (captions.download is owner-restricted); safe to leave empty.
YOUTUBE_API_KEY=
# Paid fallback when the community extractor is blocked.
# Currently supported provider: supadata
TRANSCRIPT_FALLBACK_PROVIDER=
TRANSCRIPT_FALLBACK_API_KEY=

# --- MCP server (mcp_server.py) ---
# API token from your /account page; the MCP server calls your HTTP API
# so plan gating + quotas are enforced server-side.
VTP_API_TOKEN=
VTP_API_BASE_URL=http://localhost:5000
